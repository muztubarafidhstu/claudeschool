# --- Server ---
PORT=8080
NODE_ENV=production
# Supabase -> Project Settings -> Database -> Connection string (use the "Session" pooler or direct URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/scholardesk
DATABASE_SSL=false

# Allowed browser origins for the admin panel (comma separated)
CORS_ORIGINS=https://scool.rafid5.com,http://localhost:3000

# --- Owner (you) admin login: password only ---
# Generate with: npm run hash-password -- "YourPassword"
ADMIN_PASSWORD_HASH=
# Long random string: openssl rand -hex 48
ADMIN_JWT_SECRET=

# --- RSA keys for the 7-day offline grace token (npm run keys) ---
# Either file paths or inline PEM (\n escaped) are supported.
LICENSE_PRIVATE_KEY_PATH=./keys/license_private.pem
LICENSE_PUBLIC_KEY_PATH=./keys/license_public.pem
# LICENSE_PRIVATE_KEY_PEM=
GRACE_DAYS=7

# --- Tauri auto-updater release hosting ---
RELEASES_DIR=./releases
# The admin panel (admin/out) is served by this same server at "/"
ADMIN_STATIC_DIR=../admin/out
